    <script>
      (function () {
        var guestKey = "synapse.guest";
        var isGuest = function () {
          try { return localStorage.getItem(guestKey) === "1"; } catch (e) { return false; }
        };

        /* nav stays flat until you scroll */
        var nav = document.getElementById("nav");
        var onScroll = function () { nav.classList.toggle("scrolled", window.scrollY > 8); };
        onScroll();
        window.addEventListener("scroll", onScroll, { passive: true });

        var menu = document.getElementById("menu");
        var sheet = document.getElementById("sheet");
        menu.addEventListener("click", function () {
          var open = sheet.classList.toggle("open");
          menu.setAttribute("aria-expanded", String(open));
          menu.textContent = open ? "✕" : "☰";
        });

        /* toast for screens that are not built yet */
        var toast = document.querySelector("[data-toast]");
        var toastTimer = 0;
        var soon = function () {
          toast.textContent = "Coming soon.";
          toast.classList.add("on");
          clearTimeout(toastTimer);
          toastTimer = setTimeout(function () { toast.classList.remove("on"); }, 2400);
        };
        Array.prototype.forEach.call(document.querySelectorAll("[data-soon]"), function (el) {
          el.addEventListener("click", function () { sheet.classList.remove("open"); soon(); });
        });

        /* account gate */
        var gate = document.getElementById("gate");
        var notice = document.querySelector("[data-notice]");
        var stat = document.querySelector("[data-stat]");
        var pendingScroll = false;

        var paintSession = function () {
          if (isGuest()) {
            stat.innerHTML = '<span class="guest">Guest</span>';
          }
        };
        paintSession();

        var openGate = function (scrollAfter) {
          pendingScroll = !!scrollAfter;
          notice.textContent = "";
          gate.classList.add("open");
          document.body.style.overflow = "hidden";
          gate.querySelector("[data-autofocus]").focus();
        };
        var closeGate = function () {
          gate.classList.remove("open");
          document.body.style.overflow = "";
        };

        Array.prototype.forEach.call(document.querySelectorAll("[data-start]"), function (el) {
          el.addEventListener("click", function (event) {
            if (isGuest()) return;
            event.preventDefault();
            openGate(el.getAttribute("href") === "#units");
          });
        });

        Array.prototype.forEach.call(gate.querySelectorAll("[data-close]"), function (el) {
          el.addEventListener("click", closeGate);
        });
        Array.prototype.forEach.call(gate.querySelectorAll("[data-account]"), function (el) {
          el.addEventListener("click", function () {
            notice.textContent = "Accounts aren't open yet.";
          });
        });
        gate.querySelector("[data-guest]").addEventListener("click", function () {
          try { localStorage.setItem(guestKey, "1"); } catch (e) {}
          paintSession();
          closeGate();
          if (pendingScroll) {
            document.getElementById("units").scrollIntoView({ behavior: "smooth" });
            pendingScroll = false;
          } else {
            soon();
          }
        });
        document.addEventListener("keydown", function (event) {
          if (event.key === "Escape" && gate.classList.contains("open")) {
            closeGate();
            return;
          }
          if (event.key !== "Tab" || !gate.classList.contains("open")) return;
          var buttons = gate.querySelectorAll("button");
          var first = buttons[0];
          var last = buttons[buttons.length - 1];
          if (event.shiftKey && document.activeElement === first) {
            event.preventDefault();
            last.focus();
          } else if (!event.shiftKey && document.activeElement === last) {
            event.preventDefault();
            first.focus();
          }
        });

        /* lesson: directional selection frame + answer states */
        var choices = document.querySelector("[data-choices]");
        var frame = choices.querySelector(".sel-frame");
        var size = choices.querySelector("[data-size]");
        var rows = choices.querySelectorAll(".choice");
        var feedback = document.querySelector("[data-feedback]");
        var go = document.querySelector("[data-continue]");
        var answered = false;

        var notes = {
          a: { correct: false, text: "Models only search when a tool is attached." },
          b: { correct: true, text: "It predicts one word at a time, with no lookup and no reasoning." },
          c: { correct: false, text: "No database, just patterns, so details drift." }
        };

        var measure = function (row) {
          var box = choices.getBoundingClientRect();
          var rect = row.getBoundingClientRect();
          frame.style.top = rect.top - box.top + "px";
          frame.style.left = rect.left - box.left + "px";
          frame.style.width = rect.width + "px";
          frame.style.height = rect.height + "px";
          size.textContent = Math.round(rect.width) + " × " + Math.round(rect.height);
          frame.classList.add("on");
        };

        Array.prototype.forEach.call(rows, function (row) {
          var fill = row.querySelector(".fill");

          row.addEventListener("pointerenter", function (event) {
            if (answered) return;
            var rect = row.getBoundingClientRect();
            var x = (event.clientX - rect.left) / rect.width - 0.5;
            var y = (event.clientY - rect.top) / rect.height - 0.5;
            var dir = Math.abs(x) > Math.abs(y) ? (x > 0 ? "right" : "left") : y > 0 ? "bottom" : "top";
            fill.style.animation = "none";
            void fill.offsetWidth;
            fill.style.animation = "fill-" + dir + " 300ms cubic-bezier(.22,1,.36,1) both";
            fill.style.opacity = "1";
            measure(row);
          });

          row.addEventListener("pointerleave", function () {
            if (answered) return;
            fill.style.opacity = "0";
            frame.classList.remove("on");
          });

          row.addEventListener("focus", function () {
            if (!answered) measure(row);
          });

          row.addEventListener("click", function () {
            if (answered) return;
            answered = true;
            var picked = row.getAttribute("data-id");
            var right = notes[picked].correct;

            Array.prototype.forEach.call(rows, function (other) {
              var id = other.getAttribute("data-id");
              other.disabled = true;
              other.classList.remove("muted");
              if (notes[id].correct) other.classList.add("correct");
              else if (id === picked) other.classList.add("wrong");
              else other.classList.add("muted");
            });

            frame.classList.toggle("wrong", !right);
            measure(row);

            feedback.className = "feedback on" + (right ? "" : " wrong");
            feedback.innerHTML = "<b>" + (right ? "Correct." : "Not quite.") + "</b> " + notes[picked].text;

            go.disabled = false;
            go.classList.add("ready");
            go.textContent = "Continue →";
          });
        });

        go.addEventListener("click", function () {
          if (isGuest()) soon();
          else openGate(false);
        });
      })();
    </script>
