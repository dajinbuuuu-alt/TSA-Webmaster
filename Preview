<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Synapse — AI Literacy Portal</title>
    <meta name="description" content="A gamified AI literacy course for grades 9–12." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600&family=Inter:wght@400;500&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <style>
      :root {
        --void: #000000;
        --panel: #0b0e13;
        --ink: #eaf1f8;
        --dim: #8b98a5;
        --brand: #8f00ff;
        --signal: #00ffff;
        --rose: #b76e79;
        --hair: rgba(255, 255, 255, 0.06);
        --display: "Archivo", "Inter", system-ui, sans-serif;
        --body: "Inter", system-ui, -apple-system, sans-serif;
        --mono: "JetBrains Mono", ui-monospace, monospace;
      }

      * { box-sizing: border-box; }

      body {
        margin: 0;
        background: var(--void);
        color: var(--ink);
        font-family: var(--body);
        -webkit-font-smoothing: antialiased;
        overflow-x: hidden;
      }

      h1, h2, h3 { font-family: var(--display); margin: 0; }
      p { margin: 0; }
      a { color: inherit; text-decoration: none; }
      ::selection { background: var(--brand); color: #fff; }
      :focus-visible { outline: 1px solid var(--signal); outline-offset: 3px; }

      .wrap { width: 100%; max-width: 1180px; margin: 0 auto; padding: 0 20px; }
      .eyebrow {
        font-family: var(--mono);
        font-size: 10px;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: var(--dim);
        display: flex;
        align-items: center;
        gap: 10px;
      }
      .dot { width: 6px; height: 6px; background: var(--signal); display: inline-block; }

      /* ---------- nav ---------- */
      .nav {
        position: fixed;
        inset: 0 0 auto;
        z-index: 50;
        border-bottom: 1px solid transparent;
        transition: background 0.3s, border-color 0.3s;
      }
      .nav.scrolled {
        background: rgba(0, 0, 0, 0.85);
        border-bottom-color: rgba(255, 255, 255, 0.08);
        backdrop-filter: blur(10px);
      }
      .nav-inner {
        display: flex;
        align-items: center;
        gap: 24px;
        height: 64px;
      }
      .brand { display: flex; align-items: center; gap: 10px; flex-shrink: 0; }
      .brand span {
        font-family: var(--display);
        font-size: 14px;
        font-weight: 600;
        letter-spacing: 0.14em;
      }
      .brand small {
        font-family: var(--mono);
        font-size: 9px;
        letter-spacing: 0.2em;
        color: var(--dim);
        text-transform: uppercase;
        padding-left: 10px;
        border-left: 1px solid rgba(255, 255, 255, 0.15);
      }
      .links { margin-left: auto; display: flex; gap: 4px; }
      .links a, .links button {
        font: inherit;
        font-size: 13px;
        background: none;
        border: 0;
        cursor: pointer;
        color: var(--dim);
        padding: 8px 12px;
        position: relative;
      }
      .links a:hover, .links button:hover, .links .on { color: var(--ink); }
      .links .on::after {
        content: "";
        position: absolute;
        left: 12px;
        right: 12px;
        bottom: -1px;
        height: 1px;
        background: var(--brand);
      }
      .cluster {
        display: flex;
        align-items: center;
        gap: 16px;
        border-left: 1px solid rgba(255, 255, 255, 0.1);
        padding-left: 20px;
      }
      .stat {
        font-family: var(--mono);
        font-size: 10px;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--dim);
        display: flex;
        gap: 12px;
      }
      .stat b { color: var(--ink); font-weight: 500; }
      .stat .guest { color: rgba(0, 255, 255, 0.9); }
      .start {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        height: 36px;
        padding: 0 16px;
        border-radius: 3px;
        background: var(--brand);
        color: #fff;
        font-size: 12.5px;
        font-weight: 500;
        border: 0;
        cursor: pointer;
        transition: background 0.2s;
      }
      .start:hover { background: #7b00de; }
      .menu-btn {
        display: none;
        height: 36px;
        width: 36px;
        place-items: center;
        border-radius: 3px;
        border: 1px solid rgba(255, 255, 255, 0.15);
        background: none;
        color: var(--ink);
        cursor: pointer;
      }

      /* ---------- hero ---------- */
      .hero {
        position: relative;
        overflow: hidden;
        border-bottom: 1px solid var(--hair);
        padding: 112px 0 56px;
      }
      .hero::before {
        content: "";
        position: absolute;
        inset: 0;
        background-image: radial-gradient(circle, rgba(234, 241, 248, 0.13) 1px, transparent 1px);
        background-size: 22px 22px;
        mask-image: radial-gradient(ellipse 80% 60% at 50% 0%, #000 20%, transparent 75%);
        opacity: 0.55;
        pointer-events: none;
      }
      .hero::after {
        content: "";
        position: absolute;
        inset: 0;
        background:
          radial-gradient(ellipse 45% 40% at 18% 12%, rgba(143, 0, 255, 0.22), transparent 70%),
          radial-gradient(ellipse 40% 35% at 78% 25%, rgba(0, 255, 255, 0.12), transparent 70%);
        pointer-events: none;
      }
      .hero-grid {
        position: relative;
        display: grid;
        gap: 48px;
        align-items: center;
      }
      h1 {
        margin-top: 24px;
        font-size: clamp(2.4rem, 5.1vw, 4.25rem);
        line-height: 1.02;
        font-weight: 600;
        letter-spacing: -0.035em;
      }
      h1 u {
        text-decoration-color: rgba(0, 255, 255, 0.5);
        text-decoration-thickness: 2px;
        text-underline-offset: 10px;
      }
      .sub {
        margin-top: 24px;
        max-width: 46ch;
        font-size: 15px;
        line-height: 1.75;
        color: var(--dim);
      }
      .cta { margin-top: 32px; display: flex; flex-wrap: wrap; align-items: center; gap: 12px 24px; }
      .cta .big {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        height: 44px;
        padding: 0 20px;
        border-radius: 3px;
        background: var(--brand);
        color: #fff;
        font-size: 13.5px;
        font-weight: 500;
      }
      .cta .big:hover { background: #7b00de; }
      .cta .big em {
        font-family: var(--mono);
        font-style: normal;
        font-size: 10px;
        letter-spacing: 0.14em;
        color: rgba(255, 255, 255, 0.65);
      }
      .cta .quiet {
        font-size: 13.5px;
        color: rgba(234, 241, 248, 0.8);
        border-bottom: 1px solid rgba(255, 255, 255, 0.2);
        padding-bottom: 2px;
      }
      .facts {
        margin-top: 40px;
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        font-family: var(--mono);
        font-size: 10px;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: rgba(139, 152, 165, 0.7);
      }
      .facts span { display: flex; align-items: center; gap: 12px; }
      .facts span + span::before {
        content: "";
        width: 1px;
        height: 12px;
        background: rgba(255, 255, 255, 0.1);
      }

      /* ---------- lesson card ---------- */
      .lesson {
        background: #0f1319;
        border: 1px solid rgba(54, 69, 79, 0.8);
        border-radius: 4px;
        overflow: hidden;
        box-shadow: 0 30px 70px -50px rgba(0, 0, 0, 0.9);
      }
      .bar { height: 2px; background: rgba(255, 255, 255, 0.06); }
      .bar i { display: block; height: 100%; width: 33.33%; background: var(--signal); }
      .lesson-head, .lesson-foot {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 12px 20px;
      }
      .lesson-head { border-bottom: 1px solid var(--hair); }
      .lesson-foot { border-top: 1px solid var(--hair); }
      .mono {
        font-family: var(--mono);
        font-size: 9.5px;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--dim);
      }
      .lesson-body { padding: 20px; }
      .question { font-size: 13.5px; line-height: 1.7; }

      .choices { position: relative; margin-top: 16px; display: grid; gap: 8px; }
      .choice {
        position: relative;
        display: flex;
        align-items: flex-start;
        gap: 12px;
        width: 100%;
        overflow: hidden;
        text-align: left;
        padding: 10px 12px;
        border-radius: 3px;
        border: 1px solid rgba(255, 255, 255, 0.08);
        background: rgba(255, 255, 255, 0.02);
        color: rgba(234, 241, 248, 0.85);
        font: inherit;
        font-size: 12.5px;
        line-height: 1.6;
        cursor: pointer;
        transition: border-color 0.2s, background 0.2s, color 0.2s;
      }
      .choice:hover { border-color: rgba(255, 255, 255, 0.25); }
      .choice[disabled] { cursor: default; }
      .choice .fill {
        position: absolute;
        inset: 0;
        background: rgba(234, 241, 248, 0.05);
        opacity: 0;
        pointer-events: none;
      }
      .choice .key {
        position: relative;
        margin-top: 2px;
        display: grid;
        place-items: center;
        height: 20px;
        width: 20px;
        flex-shrink: 0;
        border-radius: 2px;
        border: 1px solid rgba(255, 255, 255, 0.15);
        font-family: var(--mono);
        font-size: 10px;
        color: var(--dim);
      }
      .choice .label { position: relative; }
      .choice.correct { border-color: rgba(0, 255, 255, 0.5); background: rgba(0, 255, 255, 0.06); color: var(--ink); }
      .choice.correct .key { border-color: rgba(0, 255, 255, 0.6); color: var(--signal); }
      .choice.wrong { border-color: rgba(183, 110, 121, 0.5); background: rgba(183, 110, 121, 0.07); color: rgba(234, 241, 248, 0.9); }
      .choice.wrong .key { border-color: rgba(183, 110, 121, 0.6); color: var(--rose); }
      .choice.muted { border-color: rgba(255, 255, 255, 0.05); color: rgba(139, 152, 165, 0.6); }

      .sel-frame {
        position: absolute;
        z-index: 10;
        pointer-events: none;
        border: 1px solid rgba(0, 255, 255, 0.7);
        opacity: 0;
        transition: top 0.2s ease-out, left 0.2s ease-out, width 0.2s ease-out,
          height 0.2s ease-out, opacity 0.15s;
      }
      .sel-frame.on { opacity: 1; }
      .sel-frame.wrong { border-color: rgba(183, 110, 121, 0.7); }
      .sel-frame i {
        position: absolute;
        height: 5px;
        width: 5px;
        background: #0f1319;
        border: 1px solid rgba(0, 255, 255, 0.7);
      }
      .sel-frame.wrong i { border-color: rgba(183, 110, 121, 0.7); }
      .sel-frame i:nth-child(1) { top: -3px; left: -3px; }
      .sel-frame i:nth-child(2) { top: -3px; right: -3px; }
      .sel-frame i:nth-child(3) { bottom: -3px; left: -3px; }
      .sel-frame i:nth-child(4) { bottom: -3px; right: -3px; }
      .sel-frame span {
        position: absolute;
        top: -15px;
        right: 0;
        font-family: var(--mono);
        font-size: 8.5px;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: rgba(0, 255, 255, 0.7);
        white-space: nowrap;
      }
      .sel-frame.wrong span { color: rgba(183, 110, 121, 0.75); }

      @keyframes fill-left { from { transform: translate3d(-100%, 0, 0); } to { transform: none; } }
      @keyframes fill-right { from { transform: translate3d(100%, 0, 0); } to { transform: none; } }
      @keyframes fill-top { from { transform: translate3d(0, -100%, 0); } to { transform: none; } }
      @keyframes fill-bottom { from { transform: translate3d(0, 100%, 0); } to { transform: none; } }

      .feedback {
        margin-top: 16px;
        border-left: 2px solid rgba(0, 255, 255, 0.6);
        padding-left: 12px;
        font-size: 12px;
        line-height: 1.7;
        color: var(--dim);
        display: none;
      }
      .feedback.on { display: block; }
      .feedback.wrong { border-left-color: rgba(183, 110, 121, 0.6); }
      .feedback b { color: var(--signal); font-weight: 500; }
      .feedback.wrong b { color: var(--rose); }
      .go {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        height: 32px;
        padding: 0 14px;
        border-radius: 3px;
        border: 0;
        background: rgba(255, 255, 255, 0.05);
        color: rgba(139, 152, 165, 0.6);
        font: inherit;
        font-size: 12px;
        font-weight: 500;
        cursor: not-allowed;
      }
      .go.ready { background: var(--brand); color: #fff; cursor: pointer; }
      .go.ready:hover { background: #7b00de; }

      /* ---------- curriculum ---------- */
      section.units { border-bottom: 1px solid var(--hair); padding: 64px 0; }
      .units-head { display: flex; flex-direction: column; gap: 24px; }
      h2 {
        margin-top: 12px;
        font-size: clamp(1.9rem, 3.4vw, 2.75rem);
        font-weight: 600;
        letter-spacing: -0.03em;
      }
      .units-sub { margin-top: 12px; font-size: 13.5px; line-height: 1.7; color: var(--dim); }
      .tiers { display: flex; flex-wrap: wrap; gap: 12px 24px; }
      .tiers div { display: flex; align-items: center; gap: 8px; }
      .tiers i { width: 28px; height: 2px; display: block; }
      .tiers span {
        font-family: var(--mono);
        font-size: 9.5px;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--dim);
      }
      .grid { margin-top: 36px; display: grid; gap: 12px; }
      .unit {
        position: relative;
        background: var(--panel);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 4px;
        padding: 20px;
        display: flex;
        flex-direction: column;
        transition: border-color 0.3s, box-shadow 0.3s;
      }
      .unit:hover {
        border-color: rgba(255, 255, 255, 0.2);
        box-shadow: 0 24px 60px -45px rgba(143, 0, 255, 0.8);
      }
      .unit::before {
        content: "";
        position: absolute;
        inset: 0 0 auto;
        height: 2px;
        background: var(--rule);
      }
      .unit-top { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; }
      .unit h3 { margin-top: 16px; font-size: 19px; line-height: 1.2; font-weight: 500; letter-spacing: -0.015em; }
      .unit p { margin-top: 8px; font-size: 13px; line-height: 1.7; color: var(--dim); max-width: 46ch; }
      .unit-foot {
        margin-top: 20px;
        padding-top: 12px;
        border-top: 1px solid var(--hair);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
      }
      .unit-foot .state { font-size: 12px; color: rgba(139, 152, 165, 0.5); }
      .unit-foot button {
        font: inherit;
        font-size: 12px;
        background: none;
        border: 0;
        color: var(--ink);
        cursor: pointer;
        display: inline-flex;
        gap: 6px;
        align-items: center;
        padding: 0;
      }
      .unit.capstone { grid-column: 1 / -1; }
      .t-bronze { --rule: linear-gradient(90deg, #cd7f32 0%, #7a4a1c 100%); }
      .t-rose { --rule: linear-gradient(90deg, #b76e79 0%, #6f3a43 100%); }
      .t-gold { --rule: linear-gradient(90deg, #ffd700 0%, #9a7b00 100%); }

      /* ---------- progress ---------- */
      section.progress { padding: 56px 0; border-bottom: 1px solid var(--hair); }
      .prog-grid { margin-top: 28px; display: grid; gap: 32px; }
      .prog { border-top: 1px solid rgba(255, 255, 255, 0.08); padding-top: 16px; }
      .prog .kicker {
        display: flex;
        gap: 12px;
        font-family: var(--mono);
        font-size: 10px;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: rgba(139, 152, 165, 0.7);
      }
      .prog h3 { margin-top: 8px; font-size: 15px; font-weight: 500; }
      .bars { margin-top: 16px; display: flex; gap: 6px; }
      .bars i { height: 6px; width: 32px; display: block; }

      footer { padding: 32px 0; }
      .foot {
        display: flex;
        flex-direction: column;
        gap: 16px;
        justify-content: space-between;
      }
      .foot .mark { display: flex; align-items: center; gap: 10px; }
      .foot .mark i { width: 6px; height: 6px; background: var(--brand); display: block; }
      .foot .mark span {
        font-family: var(--mono);
        font-size: 10px;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--dim);
      }
      .foot .meta {
        font-family: var(--mono);
        font-size: 10px;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: rgba(139, 152, 165, 0.6);
      }

      /* ---------- gate ---------- */
      .gate {
        position: fixed;
        inset: 0;
        z-index: 80;
        display: none;
        align-items: center;
        justify-content: center;
        padding: 20px;
      }
      .gate.open { display: flex; }
      .gate .scrim { position: absolute; inset: 0; background: rgba(0, 0, 0, 0.8); backdrop-filter: blur(3px); }
      .panel {
        position: relative;
        width: 100%;
        max-width: 400px;
        background: #0f1319;
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 4px;
        padding: 24px;
        box-shadow: 0 40px 90px -40px rgba(0, 0, 0, 0.9);
      }
      .panel-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; }
      .panel h2 { margin-top: 12px; font-size: 22px; font-weight: 600; letter-spacing: -0.02em; }
      .panel p { margin-top: 8px; font-size: 13px; line-height: 1.7; color: var(--dim); }
      .panel .actions { margin-top: 24px; display: grid; gap: 8px; }
      .panel .actions button { font: inherit; font-size: 13px; height: 40px; border-radius: 3px; cursor: pointer; }
      .panel .primary { background: var(--brand); color: #fff; border: 0; font-weight: 500; }
      .panel .primary:hover { background: #7b00de; }
      .panel .secondary { background: none; border: 1px solid rgba(255, 255, 255, 0.15); color: var(--ink); }
      .panel .secondary:hover { background: rgba(255, 255, 255, 0.05); }
      .panel .ghost {
        background: none;
        border: 0;
        color: var(--dim);
        text-decoration: underline;
        text-decoration-color: rgba(255, 255, 255, 0.2);
        text-underline-offset: 4px;
      }
      .panel .ghost:hover { color: var(--ink); }
      .panel .x {
        background: none;
        border: 0;
        color: var(--dim);
        cursor: pointer;
        height: 28px;
        width: 28px;
        font-size: 16px;
        line-height: 1;
        margin: -4px -4px 0 0;
      }
      .panel .x:hover { color: var(--ink); }
      .notice {
        margin-top: 12px;
        min-height: 20px;
        font-size: 12px;
        line-height: 1.7;
        color: rgba(0, 255, 255, 0.8);
      }

      /* ---------- toast ---------- */
      .toast {
        position: fixed;
        left: 50%;
        bottom: 24px;
        z-index: 60;
        transform: translate(-50%, 12px);
        opacity: 0;
        transition: opacity 0.3s, transform 0.3s;
        pointer-events: none;
        background: #0f1319;
        border: 1px solid rgba(255, 255, 255, 0.15);
        border-radius: 3px;
        padding: 10px 16px;
        font-size: 12px;
        color: rgba(234, 241, 248, 0.85);
      }
      .toast.on { opacity: 1; transform: translate(-50%, 0); }

      @media (min-width: 640px) {
        .wrap { padding: 0 32px; }
        .hero { padding: 144px 0 80px; }
        .grid { grid-template-columns: 1fr 1fr; }
        .units { padding: 80px 0; }
        .units-head { flex-direction: row; align-items: flex-end; justify-content: space-between; }
        .foot { flex-direction: row; align-items: center; }
      }

      @media (min-width: 1024px) {
        .hero-grid { grid-template-columns: minmax(0, 1fr) 400px; gap: 64px; }
        .grid { grid-template-columns: repeat(3, 1fr); }
        .unit.capstone { grid-column: span 3; flex-direction: row; align-items: center; gap: 40px; padding: 28px; }
        .unit.capstone .unit-top { flex-direction: column; align-items: flex-start; gap: 4px; width: 128px; flex-shrink: 0; }
        .unit.capstone .body { flex: 1; }
        .unit.capstone h3 { margin-top: 0; font-size: 24px; }
        .unit.capstone p { max-width: 62ch; }
        .unit.capstone .unit-foot { margin-top: 0; border-top: 0; padding-top: 0; width: 176px; flex-shrink: 0; }
        .prog-grid { grid-template-columns: repeat(3, 1fr); gap: 40px; }
      }

      @media (max-width: 1023px) {
        .links, .cluster { display: none; }
        .menu-btn { display: grid; margin-left: auto; }
        .sheet { display: none; border-top: 1px solid rgba(255, 255, 255, 0.08); background: #000; }
        .sheet.open { display: block; }
        .sheet a, .sheet button {
          display: block;
          width: 100%;
          text-align: left;
          background: none;
          border: 0;
          border-bottom: 1px solid var(--hair);
          color: var(--dim);
          font: inherit;
          font-size: 14px;
          padding: 12px 0;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after {
          animation-duration: 0.001ms !important;
          transition-duration: 0.001ms !important;
        }
      }
    </style>
  </head>
  <body>
    <header class="nav" id="nav">
      <div class="wrap nav-inner">
        <a class="brand" href="#top">
          <svg width="22" height="22" viewBox="0 0 32 32" fill="none" aria-hidden="true">
            <defs>
              <linearGradient id="mark" x1="0" y1="0" x2="32" y2="32">
                <stop stop-color="#00FFFF" />
                <stop offset="1" stop-color="#8F00FF" />
              </linearGradient>
            </defs>
